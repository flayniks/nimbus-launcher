{
  "name": "nimbus-launcher",
  "productName": "Nimbus Launcher",
  "version": "1.7.0",
  "description": "A fast Minecraft: Java Edition launcher with Modrinth mods, modpacks, shaders and resource packs, every loader, every version, and a one-click FPS boost.",
  "main": "main.js",
  "license": "MIT",
  "author": "flayniks",
  "repository": "github:flayniks/nimbus-launcher",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/unit.js",
    "smoke": "node test/smoke.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.flayniks.nimbus",
    "productName": "Nimbus Launcher",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/flayniks/nimbus-launcher/releases/download/nimbus-latest",
        "channel": "latest"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "splash-preload.js",
      "net-preload.js",
      "!node_modules/three/**",
      "!node_modules/@types/**",
      "!node_modules/skinview-utils/**",
      "!node_modules/skinview3d/libs/**",
      "!node_modules/skinview3d/bundles/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Nimbus-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nimbus Launcher",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    },
    "extraResources": [
      {
        "from": "resources/mods",
        "to": "mods",
        "filter": [
          "*.jar"
        ]
      }
    ]
  },
  "homepage": "https://github.com/flayniks/nimbus-launcher"
}
